__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ---- Environment ----
.env
.env.*
!.env.example

# ---- Node / Next.js (frontend) ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/.env
