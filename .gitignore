# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- Legacy generated report paths (the API now generates PDFs in memory) ----
reports/generated/
medical_ai_*.pdf

# ---- Local dataset download scratch (raw CSVs ARE tracked) ----
datasets/raw/*_download
datasets/raw/*.zip
datasets/raw/*.rar
datasets/raw/*.arff

# NOTE: committed on purpose (demo + reproducibility):
#   models/*/            persisted pipelines, metadata, metrics, comparison CSVs
#   models/*/archive_pre_upgrade/   recoverable previous models
#   reports/figures/, reports/model_results/, reports/generated_reports/*_sample_report.pdf
#   datasets/raw/*.csv, datasets/processed/*.csv
