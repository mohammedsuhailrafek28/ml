# Backend runtime configuration for src.api (read by src/api/settings.py).
# Copy to .env for local overrides. NEVER commit a real .env or service key.

# "development" (default) or "production".
APP_ENV=development

# Comma-separated CORS origins. The private production API normally needs none
# because Next.js calls it over the internal network. Wildcards are never used.
ALLOWED_ORIGINS=http://localhost:3000

# Bind address for `python -m uvicorn src.api.main:app`.
API_HOST=127.0.0.1
API_PORT=8000

# Compose reads this runtime secret file. Create it locally with a unique,
# random 32+ character value; never put the value itself in this file.
SERVICE_API_KEY_FILE=.secrets/service_api_key

# Optional local topology controls.
APP_VERSION=0.9.0-rc.1
APP_SOURCE_REVISION=local
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=512m
API_CPUS=2.0
WEB_CPUS=1.0

# Abuse guards.
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120

# Where the persisted model folders live (defaults to <repo>/models).
MODEL_ROOT=

LOG_LEVEL=INFO
