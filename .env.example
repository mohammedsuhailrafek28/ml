# Backend runtime configuration for src.api (read by src/api/settings.py).
# Copy to .env for local overrides. NEVER commit a real .env or a real API_KEY.

# "development" (default) or "production".
APP_ENV=development

# Comma-separated CORS origins. In development this defaults to
# http://localhost:3000 when unset. In production it MUST be set explicitly;
# wildcard CORS is never enabled by default.
ALLOWED_ORIGINS=http://localhost:3000

# Bind address for `python -m uvicorn src.api.main:app`.
API_HOST=127.0.0.1
API_PORT=8000

# Optional API-key protection for /api/v1/predictions and /api/v1/reports.
# Leave blank for open demo mode (local dev needs no header). When set, clients
# must send:  X-API-Key: <this value>
API_KEY=

# Abuse guards.
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120

# Where the persisted model folders live (defaults to <repo>/models).
MODEL_ROOT=

# Where generated PDF reports are written (defaults to the system temp dir).
REPORT_DIR=

LOG_LEVEL=INFO
