# Server-only Next.js runtime configuration. Copy to .env.local for local use.
# Never rename either variable with a NEXT_PUBLIC_ prefix.

# Local development backend. In Compose this is http://api:8000.
BACKEND_INTERNAL_URL=http://localhost:8000

# Must match backend API_KEY when backend authentication is enabled. It may be
# blank only for the documented development-mode backend.
BACKEND_API_KEY=

# Optional server-boundary controls.
BACKEND_TIMEOUT_MS=8000
BFF_MAX_REQUEST_BYTES=16384
